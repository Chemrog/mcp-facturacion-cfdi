\f3\b\fs57\fsmilli28800 \cf2 \strokec2 Portal de Autofactura\
\pard\pardeftab720\sa400\partightenfactor0

\f1\b0\fs32 \cf2 Cuando creas un e-receipt, tienes la opci\'f3n de enviarlo por correo electr\'f3nico a tu cliente. En el correo se incluye un enlace a un portal de autofactura donde tu cliente podr\'e1 llenar sus datos fiscales y descargar su factura.\
Para m\'e1s informaci\'f3n consulta el art\'edculo de\'a0{\field{\*\fldinst{HYPERLINK "https://docs.facturapi.io/docs/guides/self-invoice/"}}{\fldrslt \cf4 \ul \ulc4 \strokec4 Autofactura}}.\
\pard\pardeftab720\sa400\partightenfactor0

\f3\b\fs57\fsmilli28800 \cf2 Formas de facturar recibos\
\pard\pardeftab720\sa400\partightenfactor0

\f1\b0\fs32 \cf2 Los recibos abiertos pueden facturarse a un cliente espec\'edfico o incluirse en una factura global a\'a0
\f7\fs30\fsmilli15200 \cf2 \cb7 \strokec2 PUBLICO EN GENERAL
\f1\fs32 \cf2 \cb1 \strokec2 .\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls74\ilvl0\cf4 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}{\field{\*\fldinst{HYPERLINK "https://docs.facturapi.io/api/#tag/receipt/operation/invoiceReceipt"}}{\fldrslt \expnd0\expndtw0\kerning0
\ul \outl0\strokewidth0 \strokec4 Facturar un recibo}}\cf2 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 \'a0crea una factura para un solo recibo. Si env\'edas\'a0
\f7\fs30\fsmilli15200 \cb7 customer
\f1\fs32 \cb1 , ese cliente se usa como receptor y sobrescribe el cliente asignado previamente al recibo. Si omites\'a0
\f7\fs30\fsmilli15200 \cb7 customer
\f1\fs32 \cb1 , el recibo debe tener un cliente asignado.\
\ls74\ilvl0\cf4 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}{\field{\*\fldinst{HYPERLINK "https://docs.facturapi.io/api/#tag/receipt/operation/createToInvoiceFromReceipts"}}{\fldrslt \expnd0\expndtw0\kerning0
\ul \outl0\strokewidth0 \strokec4 Facturar m\'faltiples recibos}}\cf2 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 \'a0crea una factura para varios recibos seleccionados por\'a0
\f7\fs30\fsmilli15200 \cb7 key
\f1\fs32 \cb1 . Si env\'edas\'a0
\f7\fs30\fsmilli15200 \cb7 customer
\f1\fs32 \cb1 , ese cliente se usa para todos los recibos incluidos. Si omites\'a0
\f7\fs30\fsmilli15200 \cb7 customer
\f1\fs32 \cb1 , todos los recibos deben tener asignado el mismo cliente; si hay clientes distintos o recibos sin cliente, la operaci\'f3n falla.\
\ls74\ilvl0\cf4 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}{\field{\*\fldinst{HYPERLINK "https://docs.facturapi.io/api/#tag/receipt/operation/previewToInvoiceFromReceipts"}}{\fldrslt \expnd0\expndtw0\kerning0
\ul \outl0\strokewidth0 \strokec4 Vista previa PDF de factura m\'faltiple}}\cf2 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 \'a0y\'a0
\f7\fs30\fsmilli15200 \cb7 dry_run
\f1\fs32 \cb1 \'a0validan las mismas reglas de cliente que la creaci\'f3n real, pero no persisten cambios.\
\ls74\ilvl0\cf4 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}{\field{\*\fldinst{HYPERLINK "https://docs.facturapi.io/api/#tag/receipt/operation/createGlobalInvoice"}}{\fldrslt \expnd0\expndtw0\kerning0
\ul \outl0\strokewidth0 \strokec4 Factura global}}\cf2 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 \'a0tambi\'e9n agrupa m\'faltiples recibos, pero siempre los factura al cliente gen\'e9rico\'a0
\f7\fs30\fsmilli15200 \cb7 PUBLICO EN GENERAL
\f1\fs32 \cb1 . Los recibos incluidos quedan asociados a ese cliente y cambian su\'a0
\f7\fs30\fsmilli15200 \cb7 status
\f1\fs32 \cb1 \'a0a\'a0
\f7\fs30\fsmilli15200 \cb7 "invoiced_globally"
\f1\fs32 \cb1 .\
\pard\pardeftab720\sa400\partightenfactor0

