# Neon (PostgreSQL)
NEON_DATABASE_URL=postgresql://user:password@ep-project.region.aws.neon.tech/dbname?sslmode=require
NEON_POOL_URL=postgresql://user:password@ep-project.region.aws.neon.tech/dbname?sslmode=require

# FacturAPI (API Key maestra de conectus.mx - NUNCA expuesta al usuario)
FACTURAPI_LIVE_KEY=sk_live_...
FACTURAPI_TEST_KEY=sk_test_...
FACTURAPI_USER_KEY=sk_user_...

# Encryption (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here
